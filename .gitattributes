* text=auto
*.cs text
*.shader text
*.hlsl text
*.cginc text
*.md text
*.json text
*.meta text
*.asset text
*.prefab text
*.unity text
*.dll binary
*.bundle binary
*.bin binary

# The original Main scene is about 82 MiB; keep it out of normal Git blobs.
Recovery/StudyProject/Assets/Scenes/Main.unity filter=lfs diff=lfs merge=lfs -text

# NavMesh assets are binary serialized; text conversion strips CR bytes and corrupts them.
Recovery/StudyProject/Assets/NavMeshData/*.asset binary

# Keep the development project and its small, reproducible support files.
# Original APKs, reverse-engineering exports, evidence and backups stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Docs/
!/Docs/**
!/Recovery/
/Recovery/*
!/Recovery/StudyProject/
!/Recovery/Open-StudyProject.cmd
!/Recovery/Open-StudyProject.ps1
!/Recovery/Rebuild-StudyAddressables.ps1

# Required inputs for the protected launcher and Addressables rebuild.
!/Recovery/Tools/
/Recovery/Tools/*
!/Recovery/Tools/OfficialPlugins/
/Recovery/Tools/OfficialPlugins/*
!/Recovery/Tools/OfficialPlugins/Unity.Mathematics.dll
!/Recovery/Tools/OfficialPlugins/Unity.Burst.dll
!/Recovery/Tools/AddressablesEditorTools/
/Recovery/Tools/AddressablesEditorTools/*
!/Recovery/Tools/AddressablesEditorTools/Unity.Addressables.dll
!/Recovery/Tools/AddressablesEditorTools/Unity.ResourceManager.dll
!/Recovery/Tools/AddressablesBuild/
/Recovery/Tools/AddressablesBuild/*
!/Recovery/Tools/AddressablesBuild/BuildRecoveredAddressables.cs
!/Recovery/Tools/AddressablesBuild/BuildRecoveredAddressables.cs.meta
!/Recovery/Evidence/
/Recovery/Evidence/*
!/Recovery/Evidence/addressables-recovered-asset-map.json

# Forensic sources, historical recovery projects and regenerated outputs.
/Recovery/RawExport*/
/Recovery/OriginalPackage/
/Recovery/NativeRecovery/
/Recovery/Backups/
/Recovery/*Validation/
/Recovery/AddressablesBuildProject/
/Recovery/EditorControl/
/Recovery/RuntimeDiagnostics/
/Recovery/TMPDiagnostics/
/Recovery/Logs/
/.local-cleanup/

# Unity generated directories (relative to the actual Unity project).
/Recovery/StudyProject/[Ll]ibrary/
/Recovery/StudyProject/[Tt]emp/
/Recovery/StudyProject/[Oo]bj/
/Recovery/StudyProject/[Ll]ogs/
/Recovery/StudyProject/[Uu]ser[Ss]ettings/
/Recovery/StudyProject/[Bb]uild/
/Recovery/StudyProject/[Bb]uilds/
/Recovery/StudyProject/[Mm]emoryCaptures/
/Recovery/StudyProject/[Rr]ecordings/
/Recovery/StudyProject/[Bb]urst[Dd]ebugInformation_DoNotShip/
/Recovery/StudyProject/[Bb]urst[Dd]ebugInformation_DoNotShip.meta

# IDE, OS, temporary diagnostics and personal state.
**/.vs/
**/.idea/
**/.vscode/
**/__pycache__/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pid
*.log
*.tmp
*.bak
*.pdb
*.mdb
.DS_Store
Thumbs.db
Desktop.ini
.env
.env.*
*.keystore
*.jks
*.pfx
*.p12
game_data.bin
game_data_temp.bin
game_data_backup.bin

# Do not ignore DLLs, .meta, catalog.bin, bundles, textures or other game assets.

# Balance model: extractor sources are tracked; the venv and regenerated outputs are not.
!/Balance/
/Balance/.venv/
/Balance/out/
__pycache__/
